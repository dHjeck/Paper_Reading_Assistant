# ── Server ──────────────────────────────────
PORT=3000

# ── Model Layer ─────────────────────────────
# When MODEL_PROVIDER=mock, the stub adapters are used.
# Set to "openai" or another provider when a real adapter is wired.
MODEL_PROVIDER=mock

# ── Limits ─────────────────────────────────
MAX_SELECTION_LENGTH=1200
MIN_SELECTION_LENGTH=2
MAX_FOLLOWUP_LENGTH=500
MAX_PAYLOAD_BYTES=524288

# ── Deployment ───────────────────────────────
# Set to "production" to enforce API_KEY at startup.
# NODE_ENV=production

# ── Security ──────────────────────────────────
# API_KEY=your-secret-key-here
# CORS_ORIGINS=*
# RATE_LIMIT_MAX=60

# Logging level (trace, debug, info, warn, error, fatal)
# LOG_LEVEL=info

# Thread Store
# THREAD_STORE_MAX=10000
# THREAD_STORE_TTL_MS=86400000

# ── LLM Provider ──────────────────────────────
# Can also be set per-request via X-LLM-Base-Url / X-LLM-Api-Key headers
# (sent by the Chrome extension Settings page).
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o
# LLM_TIMEOUT_MS=30000
